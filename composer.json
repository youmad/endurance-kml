{
    "name": "endurance/kml",
    "description": "Streaming KML 2.2 source inspection",
    "type": "library",
    "license": "MPL-2.0",
    "require": {
        "php": "^8.5",
        "ext-xml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Endurance\\Kml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Endurance\\Kml\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "@composer validate --strict",
            "@test"
        ]
    }
}
